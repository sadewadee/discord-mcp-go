DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=OPTIONAL_DEFAULT_SERVER_ID

# HTTP authentication is required: set MCP_AUTH_TOKEN, or the OAuth settings, or both.
# Without either the server refuses to start in HTTP mode.
#
# A fixed bearer token for clients that send a static header (at least 32 characters: openssl rand -hex 32).
MCP_AUTH_TOKEN=
#
# OAuth ("Sign in with Discord"), needed for claude.ai and other browser-based clients.
# Add <MCP_PUBLIC_URL>/oauth/discord/callback as a redirect in Developer Portal -> OAuth2.
#MCP_PUBLIC_URL=https://mcp.example.com
#DISCORD_CLIENT_SECRET=YOUR_DISCORD_OAUTH2_CLIENT_SECRET
# Discord user IDs allowed to sign in, comma-separated. The owner of DISCORD_GUILD_ID is always allowed.
#MCP_ALLOWED_USERS=
# Only if the OAuth app is not the bot's own application:
#DISCORD_CLIENT_ID=
#
# Serve HTTP without authentication anyway (only behind a proxy that authenticates every request):
#MCP_INSECURE_NO_AUTH=true
